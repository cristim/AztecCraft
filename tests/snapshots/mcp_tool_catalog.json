[
  {
    "name": "inspect_scene",
    "description": "Inspect committed editor state, including an active manipulation preview (Move, Rotate or Scale), document origin, bounded canonical curve IDs/names/class/counts/domain, retained-source counts and read-only reason, pending human edits and source-appearance readiness. A node's read-only `transform_attributes` (rotate order, rotate axis in degrees, shear, pivot translations and `non_default`) reports transform extras and is present only when at least one is non-default. Curve draw_available means at least one visible instance prepared as draw geometry; it does not claim GPU health or framebuffer success. `status_message` mirrors the native status line text (null when empty, capped at 512 characters, a fixed notice instead of file-error text that can carry a local path). No CV arrays or script bodies are exposed",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "title": "InspectArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "set_active_tool",
    "description": "Select the native Select, Move, Rotate or Scale tool; unsupported tools are not exposed",
    "inputSchema": {
      "$defs": {
        "ActiveTool": {
          "enum": [
            "select",
            "move",
            "rotate",
            "scale"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scene_token": {
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/ActiveTool"
        }
      },
      "required": [
        "scene_token",
        "tool"
      ],
      "title": "ActiveToolArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "set_tool_space",
    "description": "Set the Axis Orientation (object or world) of the Rotate or Scale tool settings, the same setting as the native Tool Settings selector; read it from inspect_scene manipulation.rotate_space and scale_space. Does not change the active tool",
    "inputSchema": {
      "$defs": {
        "SpaceInput": {
          "description": "Rotate and Scale work in the node's own axes (`object`) or the world axes (`world`).",
          "enum": [
            "object",
            "world"
          ],
          "type": "string"
        },
        "SpaceToolInput": {
          "enum": [
            "rotate",
            "scale"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Sets the Axis Orientation the Rotate or Scale tool settings use for the next manipulation.",
      "properties": {
        "scene_token": {
          "type": "string"
        },
        "space": {
          "$ref": "#/$defs/SpaceInput"
        },
        "tool": {
          "$ref": "#/$defs/SpaceToolInput"
        }
      },
      "required": [
        "scene_token",
        "tool",
        "space"
      ],
      "title": "ToolSpaceArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "begin_manipulation",
    "description": "Begin one remote-owned Move (World axis), Rotate or Scale (Object or World space) of the exact selected transform instance. Numeric manipulation may begin while any tool is active; this does not change tools",
    "inputSchema": {
      "$defs": {
        "AxisInput": {
          "enum": [
            "x",
            "y",
            "z"
          ],
          "type": "string"
        },
        "HandleInput": {
          "enum": [
            "x",
            "y",
            "z",
            "uniform"
          ],
          "type": "string"
        },
        "SpaceInput": {
          "description": "Rotate and Scale work in the node's own axes (`object`) or the world axes (`world`).",
          "enum": [
            "object",
            "world"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`kind` selects the manipulation; each kind takes its own handle fields and nothing else. Move\nworks along World axes only and takes no `space`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "axis": {
              "$ref": "#/$defs/AxisInput"
            },
            "instance_path": {
              "items": {
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array"
            },
            "kind": {
              "const": "move",
              "type": "string"
            },
            "node_id": {
              "type": "string"
            },
            "scene_token": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "scene_token",
            "node_id",
            "instance_path",
            "axis"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "axis": {
              "$ref": "#/$defs/AxisInput"
            },
            "instance_path": {
              "items": {
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array"
            },
            "kind": {
              "const": "rotate",
              "type": "string"
            },
            "node_id": {
              "type": "string"
            },
            "scene_token": {
              "type": "string"
            },
            "space": {
              "$ref": "#/$defs/SpaceInput"
            }
          },
          "required": [
            "kind",
            "scene_token",
            "node_id",
            "instance_path",
            "axis",
            "space"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "handle": {
              "$ref": "#/$defs/HandleInput"
            },
            "instance_path": {
              "items": {
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array"
            },
            "kind": {
              "const": "scale",
              "type": "string"
            },
            "node_id": {
              "type": "string"
            },
            "scene_token": {
              "type": "string"
            },
            "space": {
              "$ref": "#/$defs/SpaceInput"
            }
          },
          "required": [
            "kind",
            "scene_token",
            "node_id",
            "instance_path",
            "handle",
            "space"
          ],
          "type": "object"
        }
      ],
      "title": "BeginManipulationArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "update_manipulation",
    "description": "Preview an absolute value from begin: distance in the scene linear unit for Move, angle in the scene angular unit for Rotate, a unitless factor greater than zero for Scale. Units are echoed in inspection.manipulation.units. Matching scene token and remote-owned manipulation ID are required; a parameter of the wrong kind is a typed error",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Exactly one of distance (Move), angle (Rotate) or factor (Scale), matching the kind of the manipulation; any other is a typed manipulation_kind_mismatch error",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "distance": {
              "description": "Absolute Move distance from begin along the World axis, in the scene linear unit (inspection units.distance)",
              "type": "number"
            },
            "manipulation_id": {
              "type": "string"
            },
            "scene_token": {
              "type": "string"
            }
          },
          "required": [
            "scene_token",
            "manipulation_id",
            "distance"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "angle": {
              "description": "Absolute Rotate angle from begin about the axis, in the scene angular unit (inspection units.angle)",
              "type": "number"
            },
            "manipulation_id": {
              "type": "string"
            },
            "scene_token": {
              "type": "string"
            }
          },
          "required": [
            "scene_token",
            "manipulation_id",
            "angle"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "factor": {
              "description": "Absolute Scale factor from begin, unitless and greater than zero",
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "manipulation_id": {
              "type": "string"
            },
            "scene_token": {
              "type": "string"
            }
          },
          "required": [
            "scene_token",
            "manipulation_id",
            "factor"
          ],
          "type": "object"
        }
      ],
      "title": "UpdateManipulationArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "finish_manipulation",
    "description": "Commit one undoable Move, Rotate or Scale edit or cancel to the exact begin authoring state. Only the matching remote-owned manipulation ID may finish",
    "inputSchema": {
      "$defs": {
        "FinishInput": {
          "enum": [
            "commit",
            "cancel"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "finish": {
          "$ref": "#/$defs/FinishInput"
        },
        "manipulation_id": {
          "type": "string"
        },
        "scene_token": {
          "type": "string"
        }
      },
      "required": [
        "scene_token",
        "manipulation_id",
        "finish"
      ],
      "title": "FinishManipulationArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "create_primitive",
    "description": "Create a cube, plane, sphere, cylinder or cone in the live editor",
    "inputSchema": {
      "$defs": {
        "PrimitiveInput": {
          "enum": [
            "cube",
            "plane",
            "sphere",
            "cylinder",
            "cone"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "primitive": {
          "$ref": "#/$defs/PrimitiveInput"
        },
        "scene_token": {
          "type": "string"
        }
      },
      "required": [
        "scene_token",
        "primitive"
      ],
      "title": "CreateArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "select_node",
    "description": "Select an object using an optional full transform instance_path; ambiguous objects require a path. Null node_id clears selection without a path",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "instance_path": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "type": [
            "array",
            "null"
          ]
        },
        "node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scene_token": {
          "type": "string"
        }
      },
      "required": [
        "scene_token"
      ],
      "title": "SelectArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "set_selection_mode",
    "description": "Set Object, Face, Vertex, Edge or Hierarchy (Root sub-mask only) selection mode without editing the scene; a valid remembered face, vertex or edge stays inactive outside its own mode",
    "inputSchema": {
      "$defs": {
        "SelectionMode": {
          "enum": [
            "object",
            "face",
            "hierarchy",
            "vertex",
            "edge"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/SelectionMode"
        },
        "scene_token": {
          "type": "string"
        }
      },
      "required": [
        "scene_token",
        "mode"
      ],
      "title": "SelectionModeArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "select_face",
    "description": "Select a complete canonical face target in Face mode, or clear it with null; explicit targets need not be visible and select their owning instance",
    "inputSchema": {
      "$defs": {
        "FaceSelectionTarget": {
          "additionalProperties": false,
          "properties": {
            "face_index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "instance_path": {
              "items": {
                "type": "string"
              },
              "maxItems": 257,
              "minItems": 2,
              "type": "array"
            },
            "node_id": {
              "type": "string"
            },
            "shape_id": {
              "type": "string"
            }
          },
          "required": [
            "node_id",
            "shape_id",
            "instance_path",
            "face_index"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scene_token": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/FaceSelectionTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scene_token",
        "target"
      ],
      "title": "SelectFaceArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "select_vertex",
    "description": "Select a complete canonical vertex target in Vertex mode, or clear it with null; explicit targets need not be visible and select their owning instance",
    "inputSchema": {
      "$defs": {
        "VertexSelectionTarget": {
          "additionalProperties": false,
          "properties": {
            "instance_path": {
              "items": {
                "type": "string"
              },
              "maxItems": 257,
              "minItems": 2,
              "type": "array"
            },
            "node_id": {
              "type": "string"
            },
            "shape_id": {
              "type": "string"
            },
            "vertex_index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "node_id",
            "shape_id",
            "instance_path",
            "vertex_index"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scene_token": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/VertexSelectionTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scene_token",
        "target"
      ],
      "title": "SelectVertexArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "select_edge",
    "description": "Select a complete canonical edge target in Edge mode, or clear it with null; explicit targets need not be visible and select their owning instance",
    "inputSchema": {
      "$defs": {
        "EdgeSelectionTarget": {
          "additionalProperties": false,
          "properties": {
            "edge_index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "instance_path": {
              "items": {
                "type": "string"
              },
              "maxItems": 257,
              "minItems": 2,
              "type": "array"
            },
            "node_id": {
              "type": "string"
            },
            "shape_id": {
              "type": "string"
            }
          },
          "required": [
            "node_id",
            "shape_id",
            "instance_path",
            "edge_index"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scene_token": {
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeSelectionTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scene_token",
        "target"
      ],
      "title": "SelectEdgeArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "rename_node",
    "description": "Rename an existing object",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "scene_token": {
          "type": "string"
        }
      },
      "required": [
        "scene_token",
        "node_id",
        "name"
      ],
      "title": "RenameArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "set_transform",
    "description": "Set f64 translation in declared scene units, rotation in XYZ degrees, and scale",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string"
        },
        "rotation_degrees": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "scale": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "scene_token": {
          "type": "string"
        },
        "translation": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "scene_token",
        "node_id",
        "translation",
        "rotation_degrees",
        "scale"
      ],
      "title": "TransformArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "edit_node",
    "description": "Edit optional name and individual f64 channels in one undo entry. Omitted arrays and null components are untouched; translation uses declared scene units and supplied rotations use degrees. Does not change selection",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_id": {
          "type": "string"
        },
        "rotation_degrees": {
          "default": [
            null,
            null,
            null
          ],
          "items": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "scale": {
          "default": [
            null,
            null,
            null
          ],
          "items": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "scene_token": {
          "type": "string"
        },
        "translation": {
          "default": [
            null,
            null,
            null
          ],
          "items": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "scene_token",
        "node_id"
      ],
      "title": "EditNodeArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "extrude_face",
    "description": "Extrude one current canonical quad along its local normal by distance in declared scene units. Requires node, shape and full root-to-shape path; shared-shape edits affect every instance. Zero distance changes topology; imported structural edits remain unsupported",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "distance": {
          "format": "double",
          "type": "number"
        },
        "face_index": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "instance_path": {
          "items": {
            "type": "string"
          },
          "maxItems": 257,
          "minItems": 2,
          "type": "array"
        },
        "node_id": {
          "type": "string"
        },
        "scene_token": {
          "type": "string"
        },
        "shape_id": {
          "type": "string"
        }
      },
      "required": [
        "scene_token",
        "node_id",
        "shape_id",
        "instance_path",
        "face_index",
        "distance"
      ],
      "title": "ExtrudeArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "set_material_diffuse",
    "description": "Edit the checked saved Phong diffuse scalar for an exact shape through shared undo history. Requires complete shared-shader users; affects all those shapes. Values are finite and nonnegative, may exceed one, and do not enable rendered materials",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scene_token": {
          "type": "string"
        },
        "shape_id": {
          "type": "string"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "scene_token",
        "shape_id",
        "value"
      ],
      "title": "MaterialDiffuseArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "create_session_material",
    "description": "Create a session-only lambert material (not saved; Untitled scenes only, sourced and Maya ASCII scenes refuse) with a linear RGB colour, as its own undo step. Replies with its material_id. Material ids are decimal table indices valid only at the current history position: undo or redo can free and reuse them, so never cache one across edits",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "color": {
          "description": "Linear RGB, each channel 0 through 1.",
